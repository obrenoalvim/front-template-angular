# .env.example
# Base URL of the backend REST API this frontend talks to. Required.
API_BASE_URL=http://127.0.0.1:3000

# Public URL this site is served at — used for canonical tags, OG/Twitter meta,
# sitemap.xml and robots.txt. Required.
SITE_URL=http://localhost:4000

# Port the SSR Node server listens on. Optional, defaults to 4000.
PORT=4000
